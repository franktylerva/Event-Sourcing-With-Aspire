{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "product-api": {
        "ClusterId": "product-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "react-client": {
        "ClusterId": "react-client",
        "Match": {
          "Path": "/react/{**catch-all}"
        }
      },
      "blazor-client": {
        "ClusterId": "blazor-client",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-api": {
        "Destinations": {
          "product-api": {
            "Address": "http://product-api"
          }
        }
      },
      "react-client": {
        "Destinations": {
          "react-client": {
            "Address": "http://react-client"
          }
        }
      },
      "blazor-client": {
        "Destinations": {
          "blazor-client": {
            "Address": "http://blazor-client"
          }
        }
      }
    }
  }
}
